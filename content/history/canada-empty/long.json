,"at":[-101.2,51.15],"style":"region","cue":"everything"},{"text":"United States","at":[-100.6,47.95],"style":"region","cue":"border"}]},"pin":{"expr":"neutral","acts":[{"t":0.25,"look":[6,5]},{"cue":"hundred","point":[-97.3,49.45],"hold":1.0}]},"chapter":"The thin strip"},{"type":"data","narration":"That's about {4%|four percent} of the land, holding {66%|sixty-six percent} of the people.","data":{"kicker":"2016 Census","title":"The *thin strip*","rows":[{"label":"LAND","value":4,"display":"4%","cue":"four"},{"label":"PEOPLE","value":66,"display":"66%","cue":"sixty-six","highlight":true}],"source":"Statistics Canada, The Daily, 8 Feb 2017"},"pin":{"expr":"neutral","acts":[{"t":0.3,"look":[8,-6]},{"cue":"sixty-six","dt":0.9,"expr":"surprised"}]}},{"type":"data","narration":"Spread out, Canada had about {3.9|three point nine} people per square kilometre. The US had {35.3|thirty-five point three}.","data":{"kicker":"People per km², 2016","title":"Room to *spare*","rows":[{"label":"CANADA","value":3.9,"decimals":1,"suffix":"","cue":"three"},{"label":"UNITED STATES","value":35.3,"decimals":1,"suffix":"","cue":"thirty-five","highlight":true}],"source":"Statistics Canada, The Daily, 8 Feb 2017"},"pin":{"expr":"neutral","acts":[{"t":0.3,"look":[8,-6]},{"cue":"thirty-five","dt":0.6,"expr":"surprised"}]}},{"type":"map","narration":"And the strip sits further south than you'd think. Toronto is further south than Minneapolis.","cam":[{"from":"prev","t":0},{"fit":[-101,39.5,-70,50.5],"pad":0.0,"t":1.5,"ease":"power3.inOut"},{"fit":[-100,40.0,-71,50.0],"pad":0.0,"t":"end","ease":"sine.inOut"}],"data":{"layers":{"strip":{"lit":true,"opacity":0.5},"border":{"draw":false},"parallel49":{"lit":true}},"labels":[{"text":"Toronto","style":"city","anchor":"n","cue":"toronto"},{"text":"43.7°N","at":[-79.4,42.400000000000006],"style":"tag","anchor":"n","cue":"toronto","dt":0.3},{"text":"Minneapolis","style":"city","anchor":"s","cue":"minneapolis"},{"text":"45.0°N","at":[-93.3,46.3],"style"