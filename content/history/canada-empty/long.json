]},{"cue":"three","expr":"neutral","needle":"tremble"}]},"blur":[{"t":0,"b":4},{"cue":"three","b":0,"dur":0.8}],"rack":true},{"type":"map","narration":"One: frozen ground. Permafrost lies under roughly half of Canada.","cam":[{"from":"prev","t":0},{"fit":"north","pad":0.06,"t":1.5,"ease":"expo.out"},{"fit":"north","pad":0.0,"t":"end","ease":"sine.inOut"}],"data":{"layers":{"territories":{"cue":"frozen","opacity":0.3},"regions":{"names":["Barren Grounds","Arctic Archipelago"],"lit":true,"opacity":0.4},"parallel49":{"lit":true},"border":{"draw":false}},"labels":[{"text":"Permafrost","at":[-110.0,66.0],"style":"region","cue":"permafrost"},{"text":"~50% of Canada","at":[-100.0,70.5],"style":"callout","anchor":"n","cue":"half"}]},"pin":{"expr":"worried","acts":[{"t":0.2,"look":[3,-9]},{"cue":"frozen","needle":"tremble"},{"cue":"half","expr":"surprised"}]},"chapter":"Frozen ground","source":"The Canadian Encyclopedia, Permafrost"},{"type":"pin","narration":"That's ground that stays frozen for years at a time. You can't plow it, and summers up there are short.","cam":[{"fit":"canada","pad":0.0,"nudge":[-0.16,0.06],"t":0},{"fit":"canada","pad":-0.05,"nudge":[-0.16,0.06],"t":"end","ease":"sine.inOut"}],"data":{"layers":{"regions":{"names":["Barren Grounds"],"lit":true,"opacity":0.4},"territories":{"opacity":0.3}},"labels":[{"text":"Barren Grounds","at":[-97.0,64.6],"style":"region","cue":"frozen","dt":0.3}]},"pin":{"expr":"worried","acts":[{"t":0.2,"look":[8,-8]},{"cue":"plow","needle":"tremble"},{"cue":"short","expr":"neutral"}]},"blur":[{"t":0,"b":9},{"cue":"frozen","b":0,"dur":0.9}]},{"type":"map","narration":"Two: rock. The Canadian Shield covers roughly half of Canada's land.","cam":[{"fit":"canada","pad":0.06,"t":0},{"fit":"canada","pad":0.0,"t":"end","ease":"sine.inOut"}],"data":{"layers":{"regions":{"names":["Canadian Shield"],"lit":true,"opacity":0.45,"cue":"shield"},"strip":{"lit":true,"opacity":0.35},"border":{"draw":false},"parallel49":{"lit":true,"label":false}},"labels":[{"text":"Canadian Shield","at":[-82.0,56.5],"style":"region","cue":"shield"},{"text":"~half the land","at":[-88.0,61.5],"style":"callout","anchor":"n","cue":"half"}]},"pin":{"expr":"neutral","acts":[{"t":0.2,"look":[8,-4]},{"cue":"rock","expr":"surprised","point":[-82.0,55.0],"hold":1.2}]},"chapter":"Bare rock","source":"The Canadian Encyclopedia, Canadian Shield"},{"type":"data","narration":"About {5 million|five million} square kilometres of bare rock, thin soil, muskeg and thousands of small lakes.","data":{"kicker":"The Canadian Shield","title":"*5 million* km² of rock","rows":[{"label":"SHARE OF CANADA'S LAND (ROUGHLY)","value":50,"cue":"rock","highlight":true}],"source":"The Canadian Encyclopedia; Statistics Canada"},"pin":{"expr":"thinking","acts":[{"t":0.3,"look":[8,-6]},{"cue":"lakes","expr":"neutral"}]}},{"type":"data","narration":"Three: farmland. In {2021|twenty twenty-one}, only {6.2%|six point two percent} of Canada's land was farmland.","data":{"kicker":"2021, the ten provinces","title":"Room to *farm*","rows":[{"label":"FARMLAND","value":6.2,"decimals":1,"cue":"six","highlight":true},{"label":"EVERYTHING ELSE","value":93.8,"decimals":1,"cue":"land"}],"source":"Statistics Canada, 2021 Census of Agriculture"},"pin":{"expr":"neutral","acts":[{"t":0.3,"look":[8,-6]},{"cue":"six","dt":0.6,"expr":"worried"}]},"chapter":"Little farmland"},{"type":"map","narration":"The good soil and the long-enough summers are in the south: the Prairies, and the lowlands by the Great Lakes.","cam":[{"fit":[-120,41.5,-64,56.0],"pad":0.0,"t":0},{"fit":[-118,42.0,-66,55.0],"pad":0.0,"t":"end","ease":"sine.inOut"}],"data":{"layers":{"regions":{"names":["Great Plains","Canadian Shield"],"lit":true,"opacity":0.32},"strip":{"lit":true,"opacity":0.45},"border":{"draw":false},"parallel49":{"lit":true,"label":false}},"labels":[{"text":"Prairies","at":[-106.0,51.2],"style":"region","cue":"prairies"},{"text":"Regina","style":"city","anchor":"s","cue":"prairies","dt":0.3},{"t