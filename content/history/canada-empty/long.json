w* people","rows":[{"label":"SHARE OF CANADA'S LAND (APPROX.)","value":23,"cue":"two"},{"label":"SHARE OF CANADA'S PEOPLE","value":0.1,"decimals":1,"cue":"thirty-six","highlight":true}],"source":"Statistics Canada 2021; StatCan 2017 land area"},"pin":{"expr":"surprised","acts":[{"t":0.3,"look":[8,-6]},{"cue":"live","expr":"worried"}]}},{"type":"map","narration":"Now, the thing under the snow: the rock. The Shield reaches down close to the Great Lakes. The good land is a narrow band beside it, and that band runs along the US border.","cam":[{"fit":[-98,41.0,-62,52.0],"pad":0.0,"t":0},{"fit":[-92,41.5,-64,50.5],"pad":0.0,"t":"end","ease":"power2.inOut"}],"data":{"layers":{"regions":{"names":["Canadian Shield"],"lit":true,"opacity":0.45,"cue":"rock"},"strip":{"lit":true,"opacity":0.6,"pulse":2},"border":{"cue":"border","dur":1.6},"parallel49":{"lit":true,"label":false}},"labels":[{"text":"Canadian Shield","at":[-78.0,49.2],"style":"region","cue":"shield"},{"text":"Toronto","style":"city","anchor":"s","cue":"band"},{"text":"Montréal","style":"city","anchor":"n","cue":"narrow"}]},"pin":{"expr":"thinking","acts":[{"t":0.2,"look":[8,-6]},{"cue":"rock","expr":"surprised"},{"cue":"band","point":[-77.5,44.2],"hold":1.4,"expr":"happy"}]},"chapter":"Why the border"},{"type":"map","narration":"So cities grew in the south, strung along the border like beads.","cam":[{"from":"prev","t":0},{"fit":[-127,42.5,-61,51.5],"pad":0.0,"t":1.4,"ease":"power3.inOut"}],"data":{"layers":{"strip":{"lit":true,"opacity":0.45},"border":{"draw":false},"parallel49":{"lit":true,"label":false},"routes":[{"via":["Vancouver","Calgary","Regina","Winnipeg","Thunder Bay","Toronto","Montréal","Québec","Halifax"],"cue":"grew","dur":3.4,"beads":[{"text":"Vancouver","anchor":"s","at":0.02},{"text":"Calgary","anchor":"n","at":0.14},{"text":"Winnipeg","anchor":"s","at":0.36},{"text":"Toronto","anchor":"s","at":0.68},{"text":"Montréal","anchor":"n","at":0.78},{"text":"Halifax","anchor":"s","at":0.98}]}]}},"pin":{"expr":"neutral","acts":[{"cue":"grew","expr":"happy","hop":true},{"cue":"beads","look":[9,-3]}]}},{"type":"pin","narration":"That's why most of Canada is empty: frozen ground, bare rock and very little farmland. The people are in the strip.","cam":[{"fit":"canada","pad":0.0,"nudge":[-0.16,0.06],"t":0},{"fit":"canada","pad":-0.05,"nudge":[-0.16,0.06],"t":"end","ease":"sine.inOut"}],"data":{"layers":{"strip":{"lit":true,"opacity":0.9},"parallel49":{"lit":true,"label":false}}},"pin":{"expr":"proud","acts":[{"t":0.2,"look":[8,-6]},{"cue":"frozen","expr":"neutral"},{"cue":"strip","expr":"happy","hop":true}]},"blur":[{"t":0,"b":9},{"cue":"people","b":0,"dur":0.9}],"rack":true},{"type":"map","narration":"So next time you see a map of Canada, remember: two in three live right here.","cam":[{"fit":"canada","pad":0.04,"t":0},{"fit":"canada","pad":-0.01,"t":"end","ease":"sine.inOut"}],"data":{"layers":{"strip":{"lit":true},"border":{"draw":false},"parallel49":{"lit":true}},"labels":[{"text":"2 in 3","at":[-79.4,43.7],"style":"callout","anchor":"n","cue":"two"}]},"pin":{"expr":"happy","acts":[{"t":0.3,"look":[0,0]},{"cue":"here","point":[-79.4,43.7],"hold":1.0}]},"hold":0.25},{"type":"end","narration":"There's a new map every Wednesday. Pick one, and I'll see you there.","min_duration":7.0,"cam":[{"fit":"canada","pad":0.3,"t":0},{"fit":"canada","pad":0.24,"t":"end","ease":"sine.inOut"}],"blur":[{"t":0,"b":4}],"data":{"layers":{"parallel49":{"lit":true,"label":false}},"tagline":"The US and Canada, explained on the map","slot":"WATCH NEXT","next":"New map every Wednesday"},"pin":{"expr":"happy","acts":[{"t":0.4,"hop":true},{"t":2.2,"point":{"deg":70},"hold":1.6}]}}]}
