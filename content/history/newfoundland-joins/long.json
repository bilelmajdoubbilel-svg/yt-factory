 "region", "cue": "united"}, {"text": "Newfoundland", "at": [-56.6, 48.8], "style": "region", "lit": true}, {"text": "Economic Union?", "at": [-63.0, 44.2], "style": "tag", "anchor": "c", "cue": "deal"}], "source": "Heritage Newfoundland and Labrador"}, "pin": {"expr": "surprised", "acts": [{"t": 0.3, "look": [8, -6]}, {"cue": "united", "expr": "surprised"}]}}, {"type": "data", "narration": "On {June 3, 1948|June third, nineteen forty-eight}, the first vote. Self-government: {44.6%|forty-four point six percent}. Canada: {41.1%|forty-one point one}. The commission: {14.3%|fourteen point three}. No majority.", "data": {"kicker": "Referendum 1, 3 June 1948", "title": "Nobody *wins*", "rows": [{"label": "SELF-GOVERNMENT", "value": 44.6, "decimals": 1, "cue": "44.6%", "highlight": true}, {"label": "CONFEDERATION", "value": 41.1, "decimals": 1, "cue": "41.1%"}, {"label": "COMMISSION", "value": 14.3, "decimals": 1, "cue": "14.3%"}], "source": "Heritage Newfoundland and Labrador"}, "pin": {"expr": "neutral", "acts": [{"t": 0.3, "look": [8, -6]}, {"cue": "majority", "expr": "worried"}]}}, {"type": "data", "narration": "So, a runoff on {July 22|July twenty-second}. Canada: {52.3%|fifty-two point three percent}. Self-government: {47.7%|forty-seven point seven}.", "data": {"kicker": "Referendum 2, 22 July 1948", "title": "Canada, *barely*", "rows": [{"label": "CONFEDERATION", "value": 52.3, "decimals": 1, "cue": "52.3%", "highlight": true}, {"label": "SELF-GOVERNMENT", "value": 47.7, "decimals": 1, "cue": "47.7%"}], "source": "Heritage Newfoundland and Labrador"}, "pin": {"expr": "neutral", "acts": [{"t": 0.3, "look": [8, -6]}, {"cue": "52.3%", "expr": "surprised"}]}}, {"type": "map", "chapter": "The split", "narration": "Now look at where those votes came from. On the Avalon Peninsula, around St. John's, {66%|sixty-six percent} voted to govern themselves.", "cam": [{"from": "prev", "t": 0}, {"fit": [-54.6, 46.5, -52.4, 48.3], "pad": 0.02, "t": 2.0, "ease": "power3.inOut"}, {"f