expr": "surprised", "acts": [{"t": 0.3, "look": [8, -6]}, {"cue": "suspended", "expr": "worried"}]}}, {"type": "pin", "narration": "For fifteen years, Newfoundland was run by an unelected commission, directed by Britain.", "cam": [{"fit": [-59.8, 46.4, -52.3, 51.9], "pad": 0.0, "t": 0, "nudge": [-0.16, 0.06]}, {"fit": [-59.8, 46.4, -52.3, 51.9], "pad": -0.05, "t": "end", "ease": "sine.inOut", "nudge": [-0.16, 0.06]}], "data": {}, "pin": {"expr": "worried", "acts": [{"t": 0.2, "look": [8, -6]}, {"cue": "unelected", "expr": "worried"}, {"cue": "britain", "needle": "waver"}]}, "blur": [{"t": 0, "b": 9}]}, {"type": "pin", "narration": "If you like maps that explain things, subscribe. There's a new map every other day.", "cam": [{"fit": [-59.8, 46.4, -52.3, 51.9], "pad": 0.0, "t": 0, "nudge": [-0.16, 0.06]}, {"fit": [-59.8, 46.4, -52.3, 51.9], "pad": -0.05, "t": "end", "ease": "sine.inOut", "nudge": [-0.16, 0.06]}], "data": {"layers": {"routes": [{"via": [[-53.542, 48.108], [-53.569, 48.088], [-53.704, 48.068], [-53.87, 48.02], [-53.794, 48.01], [-53.653, 48.026], [-53.638, 48.015], [-53.695, 47.921], [-53.864, 47.787], [-53.805, 47.682], [-53.765, 47.65], [-53.672, 47.648], [-53.604, 47.662], [-53.504, 47.744], [-53.283, 47.998], [-52.921, 48.147], [-52.866, 48.113], [-52.998, 47.976], [-53.154, 47.735], [-53.176, 47.653], [-53.17, 47.512], [-53.122, 47.455], [-52.945, 47.553], [-52.873, 47.619], [-52.782, 47.769], [-52.745, 47.769], [-52.711, 47.745], [-52.654, 47.549], [-52.684, 47.426], [-52.912, 47.103], [-52.888, 47.046], [-52.889, 46.974], [-52.962, 46.819], [-53.07, 46.681], [-53.167, 46.647], [-53.214, 46.661], [-53.291, 46.717], [-53.323, 46.718], [-53.382, 46.711], [-53.536, 46.633], [-53.59, 46.639], [-53.616, 46.68], [-53.581, 46.957], [-53.612, 47.01], [-53.58, 47.099], [-53.578, 47.133], [-53.597, 47.146], [-53.636, 47.138], [-53.86, 46.939], [-54.01, 46.84], [-54.102, 46.825], [-54.174, 46.88], [-54.155, 46.967], [-54.093, 47.086], [-53.869, 47.387], [-53